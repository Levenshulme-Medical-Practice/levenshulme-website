{%- macro icon(name, size=26) -%}
<svg class="icon" aria-hidden="true" focusable="false" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
{%- if name == "stethoscope" -%}<path d="M6 3v6a4 4 0 0 0 8 0V3"/><path d="M10 13v3a5 5 0 0 0 10 0v-2"/><circle cx="20" cy="12" r="2"/>
{%- elif name == "pill" -%}<rect x="3" y="9" width="18" height="6" rx="3" transform="rotate(-45 12 12)"/><path d="M9.5 9.5l5 5"/>
{%- elif name == "thermometer" -%}<path d="M14 4v10.5a3.5 3.5 0 1 1-4 0V4a2 2 0 0 1 4 0z"/><path d="M12 15v2"/>
{%- elif name == "document" -%}<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/><path d="M8 14h8"/><path d="M8 18h5"/>
{%- elif name == "movement" -%}<circle cx="12" cy="4" r="2"/><path d="M12 6v7"/><path d="M12 13l-4 8"/><path d="M12 13l4 8"/><path d="M6 9l6-1 6 1"/>
{%- elif name == "testtube" -%}<path d="M9 3h6"/><path d="M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3"/><path d="M7.5 15h9"/>
{%- elif name == "question" -%}<circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6V14"/><path d="M12 17.5v.01"/>
{%- elif name == "letter" -%}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>
{%- elif name == "menu" -%}<path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/>
{%- elif name == "chevron" -%}<path d="M9 6l6 6-6 6"/>
{%- else -%}<circle cx="12" cy="12" r="9"/>
{%- endif -%}
</svg>
{%- endmacro -%}
